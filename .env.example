OPENAI_API_KEY=your_openai_api_key_here


PGVECTOR_URL=jdbc:postgresql://localhost:5432/reverseengineering
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres


OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


OPENAI_QUERY_TEMPERATURE=0.3
OPENAI_CHAIN_TEMPERATURE=0.1
OPENAI_SYNTHESIS_TEMPERATURE=0.2
OPENAI_QUERY_MAX_TOKENS=1500
OPENAI_CHAIN_MAX_TOKENS=3000
OPENAI_SYNTHESIS_MAX_TOKENS=6000


# Auth: HMAC-SHA256 signing key for the JWTs this backend issues and validates.
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=reverse-engineering-agent
JWT_TTL_SECONDS=3600

# Set to false in a public deployment to disable the MCP server: the
# unauthenticated /sse and /message endpoints are then never registered.
# The REST API and frontend are unaffected.
MCP_ENABLED=true

ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_REPO_HOSTS=github.com
MAX_FILES_TO_LOAD=2000
MAX_FILE_BYTES=524288
MAX_TOTAL_SOURCE_CHARS=8388608
MAX_QUERY_K=20
MAX_DOCUMENT_K=40
MAX_QUESTION_LENGTH=4000
MAX_PROJECT_NAME_LENGTH=120

# Per-user, per-day limits for the token-expensive endpoints (0 = unlimited).
# Counters reset at 00:00 UTC.
MAX_QUERIES_PER_USER=2
MAX_DOCUMENTS_PER_USER=2

# Combined daily OpenAI token ceiling across every account, as a safety net
# against many-account abuse (0 = disabled). Also set a hard billing limit in
# your OpenAI dashboard.
GLOBAL_DAILY_TOKEN_BUDGET=5000000

# Ceilings on ingested repositories (0 = unlimited). Every project adds
# vector-store rows that are never auto-pruned.
MAX_PROJECTS_PER_USER=10
MAX_PROJECTS_TOTAL=200

# Redis backs the rate limiter and usage/quota budgets. Without it, each app
# instance keeps its own counters and they reset on restart.
REDIS_HOST=localhost
REDIS_PORT=6379
# Managed Redis usually needs a password and TLS; leave blank / false for local.
REDIS_PASSWORD=
REDIS_SSL=false
# true in production: refuse to start if Redis is unreachable, and log a later
# outage at ERROR instead of silently degrading to in-memory limits.
REDIS_REQUIRED=true


